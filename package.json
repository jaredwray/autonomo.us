{
	"name": "autonomo.us",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"author": "Jared Wray",
	"type": "module",
	"scripts": {
		"build": "pnpm run --recursive --sequential build",
		"test": "vitest run --coverage",
		"test:ci": "vitest run --coverage",
		"test:worker": "pnpm --filter @autonomo.us/server exec tsx scripts/test-worker.ts",
		"check:deployment": "pnpm --filter @autonomo.us/server exec tsx scripts/check-deployment.ts",
		"lint": "npx @biomejs/biome check .",
		"lint:fix": "npx @biomejs/biome check --write .",
		"clean": "pnpm run --recursive clean",
		"deploy:development": "pnpm --filter @autonomo.us/ux... build && wrangler deploy -c core/server/wrangler.jsonc"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.11",
		"@vitest/coverage-v8": "^4.1.4",
		"tsdown": "^0.21.8",
		"typescript": "^6.0.2",
		"vitest": "^4.1.4",
		"wrangler": "^4.152.0"
	},
	"packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
