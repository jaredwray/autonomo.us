{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "autonomous-ux-development",
	"compatibility_date": "2026-10-22",
	"workers_dev": false,
	"preview_urls": false,
	"send_metrics": false,
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"routes": [
		{
			"pattern": "dev.autonomo.us",
			"custom_domain": true
		}
	]
}
