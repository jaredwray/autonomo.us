{
	"name": "@autonomo.us/common",
	"version": "0.0.0",
	"description": "Shared types and utilities for autonomo.us",
	"license": "MIT",
	"author": "Jared Wray",
	"repository": {
		"type": "git",
		"url": "https://github.com/jaredwray/autonomo.us.git",
		"directory": "core/common"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsdown src/index.ts --format esm,cjs --dts",
		"test": "vitest run --coverage",
		"clean": "rm -rf dist"
	}
}
