{
	"name": "@autonomo.us/api",
	"version": "0.0.0",
	"description": "AI gateway API service for autonomo.us",
	"license": "MIT",
	"author": "Jared Wray",
	"repository": {
		"type": "git",
		"url": "https://github.com/jaredwray/autonomo.us.git",
		"directory": "core/api"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts src/start.ts --format esm,cjs --dts",
		"dev": "tsx watch src/start.ts",
		"models:update": "tsx scripts/update-models.ts",
		"start": "node dist/start.mjs",
		"test": "vitest run --coverage",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.16",
		"@ai-sdk/openai-compatible": "^3.0.12",
		"@autonomo.us/common": "workspace:*",
		"@fastify/cors": "^11.3.0",
		"ai": "^7.0.31",
		"cacheable": "^2.5.0",
		"fastify": "^5.8.4",
		"mongodb": "^7.1.1"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"tsx": "^4.21.0"
	}
}
