{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "autonomous-api-development",
	"main": "./src/worker.ts",
	// nodejs_compat (and the Node HTTP server) is on for dates on or after 2026-08-04.
	"compatibility_date": "2026-10-22",
	"workers_dev": false,
	"preview_urls": false,
	"send_metrics": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"upload_source_maps": true,
	"vars": {
		"CORS_ORIGIN": "https://dev.autonomo.us"
	},
	"routes": [
		{
			"pattern": "dev-api.autonomo.us",
			"custom_domain": true
		}
	]
}
