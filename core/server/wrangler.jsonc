{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// Edge assets and routing; the API runs in a full Node Linux container.
	"name": "autonomous-server-development",
	"main": "./src/container-worker.ts",
	// Native Durable Object Container API, durable_object scheduling policy.
	"compatibility_date": "2026-11-16",
	"workers_dev": false,
	"preview_urls": false,
	"send_metrics": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"upload_source_maps": true,
	// The dashboard build (pnpm --filter @autonomo.us/ux build). Paths in
	// run_worker_first reach Fastify; every other path is answered from this
	// directory without invoking the Worker, with index.html standing in for
	// the dashboard's client-side routes.
	"assets": {
		"directory": "../ux/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/v1",
			"/v1/*",
			"/mcp",
			"/oauth/*",
			"/.well-known/*",
			"/health",
			"/healthz"
		]
	},
	"vars": {
		"CORS_ORIGIN": "https://dev.autonomo.us",
		"PUBLIC_URL": "https://dev.autonomo.us"
	},
	"triggers": { "crons": ["* * * * *"] },
	"containers": [{
		"class_name": "GatewayContainer",
		"scheduling_policy": "durable_object",
		"images": { "base": { "dockerfile": "./Dockerfile", "build_context": "../.." } }
	}],
	"durable_objects": { "bindings": [{ "name": "GATEWAY", "class_name": "GatewayContainer" }] },
	"exports": { "GatewayContainer": { "type": "durable-object", "storage": "sqlite" } },
	"routes": [
		{
			"pattern": "dev.autonomo.us",
			"custom_domain": true
		}
	]
}
