{
	"name": "@autonomo.us/common",
	"version": "0.0.0",
	"description": "Shared types and utilities for autonomo.us",
	"license": "MIT",
	"author": "Jared Wray",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsup src/index.ts --format esm,cjs --dts",
		"test": "vitest run --coverage",
		"clean": "rm -rf dist"
	}
}
